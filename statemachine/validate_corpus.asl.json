{
  "Comment": "Runs pulp-analytics/horror-corpus-validation's scripts/01-10 respecting the real dependency graph (01→{02,03,07,08}, 02→{04,08}, 04→{05,09}, 05→06). The 5 full-corpus-scale scripts (02,03,04,05,06) run as AWS Batch array jobs, each array child self-selecting its shard via AWS_BATCH_JOB_ARRAY_INDEX, followed by a MergeShards step; 01/07/08/09/Assemble process a small/bounded row count and run as single Fargate ECS tasks instead -- see docs/ARCHITECTURE.md for why the split isn't uniform. REPLACE_WITH_* placeholders need your own resource ids.",
  "StartAt": "Enumerate",
  "States": {
    "Enumerate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "REPLACE_WITH_CLUSTER_ARN",
        "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["REPLACE_WITH_SUBNET_ID"],
            "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [{
            "Name": "validator",
            "Command.$": "States.Array('python3', 'scripts/01_tmdb_enumerate.py', '--genre', States.Format('{}', $.genre), '--start-year', States.Format('{}', $.startYear), '--end-year', States.Format('{}', $.endYear), '--limit', States.Format('{}', $.limit), '--out', $.idsPath)"
          }]
        }
      },
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Next": "IndependentGates"
    },

    "IndependentGates": {
      "Type": "Parallel",
      "Comment": "03, 07, and the 02-rooted branch only depend on 01's output -- none of them need each other.",
      "Branches": [
        {
          "StartAt": "FetchAltTitlesShards",
          "States": {
            "FetchAltTitlesShards": {
              "Type": "Task",
              "Resource": "arn:aws:states:::batch:submitJob.sync",
              "Parameters": {
                "jobName": "fetch-alt-titles",
                "jobQueue": "REPLACE_WITH_JOB_QUEUE_ARN",
                "jobDefinition": "REPLACE_WITH_JOB_DEFINITION_ARN",
                "arrayProperties": { "size.$": "$.shardCount" },
                "containerOverrides": {
                  "command.$": "States.Array('sh', '-c', States.Format('python3 scripts/03_fetch_alt_titles.py --shard-index $AWS_BATCH_JOB_ARRAY_INDEX --shard-count {} --in {} --out {}/shard_${AWS_BATCH_JOB_ARRAY_INDEX}_alt_titles.json', $.shardCount, $.idsPath, $.shardDir))"
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
              "Next": "MergeAltTitles"
            },
            "MergeAltTitles": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [{
                    "Name": "validator",
                    "Command.$": "States.Array('python3', 'merge_shards.py', '--format', 'json', '--shard-glob', States.Format('{}/shard_*_alt_titles.json', $.shardDir), '--expected-count', States.Format('{}', $.shardCount), '--out', $.altTitlesPath)"
                  }]
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
              "End": true
            }
          }
        },
        {
          "StartAt": "DedupeMetadata",
          "States": {
            "DedupeMetadata": {
              "Type": "Task",
              "Comment": "Not sharded -- 07 only checks the small set of title+year+overview duplicate CANDIDATES it finds locally first (a tiny fraction of the corpus: ~18 groups out of 145k rows in the real run), not every row, so there's no per-row throughput problem here to solve.",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [{
                    "Name": "validator",
                    "Command.$": "States.Array('python3', 'scripts/07_dedupe_tmdb_metadata.py', '--in', $.idsPath, '--out', $.duplicateResolutionPath, '--cache', $.tmdbDedupeCachePath)"
                  }]
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
              "End": true
            }
          }
        },
        {
          "StartAt": "VerifyPosterShards",
          "States": {
            "VerifyPosterShards": {
              "Type": "Task",
              "Resource": "arn:aws:states:::batch:submitJob.sync",
              "Parameters": {
                "jobName": "verify-poster",
                "jobQueue": "REPLACE_WITH_JOB_QUEUE_ARN",
                "jobDefinition": "REPLACE_WITH_JOB_DEFINITION_ARN",
                "arrayProperties": { "size.$": "$.shardCount" },
                "containerOverrides": {
                  "command.$": "States.Array('sh', '-c', States.Format('python3 scripts/02_verify_poster_exists.py --shard-index $AWS_BATCH_JOB_ARRAY_INDEX --shard-count {} --in {} --out {}/shard_${AWS_BATCH_JOB_ARRAY_INDEX}_poster_verification.csv', $.shardCount, $.idsPath, $.shardDir))"
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
              "Next": "MergeVerifyPoster"
            },
            "MergeVerifyPoster": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [{
                    "Name": "validator",
                    "Command.$": "States.Array('python3', 'merge_shards.py', '--format', 'csv', '--shard-glob', States.Format('{}/shard_*_poster_verification.csv', $.shardDir), '--expected-count', States.Format('{}', $.shardCount), '--out', $.verifiedPath)"
                  }]
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
              "Next": "AfterVerify"
            },
            "AfterVerify": {
              "Type": "Parallel",
              "Comment": "04 and 08 are the only two steps that download the poster image itself, so both -- and only both -- depend on 02's verified=1 result.",
              "Branches": [
                {
                  "StartAt": "BedrockOCRShards",
                  "States": {
                    "BedrockOCRShards": {
                      "Type": "Task",
                      "Comment": "Highest-value script to shard: a Bedrock call per row, the slowest and most numerous step in a full run. Longer retry backoff than the other array jobs -- Bedrock throttling (ThrottlingException) under concurrent load across many array children is the most likely transient failure here.",
                      "Resource": "arn:aws:states:::batch:submitJob.sync",
                      "Parameters": {
                        "jobName": "bedrock-ocr",
                        "jobQueue": "REPLACE_WITH_JOB_QUEUE_ARN",
                        "jobDefinition": "REPLACE_WITH_JOB_DEFINITION_ARN",
                        "arrayProperties": { "size.$": "$.shardCount" },
                        "containerOverrides": {
                          "command.$": "States.Array('sh', '-c', States.Format('python3 scripts/04_bedrock_ocr.py --shard-index $AWS_BATCH_JOB_ARRAY_INDEX --shard-count {} --in {} --out {}/shard_${AWS_BATCH_JOB_ARRAY_INDEX}_vision_title_check.csv --verified {} --model {}', $.shardCount, $.idsPath, $.shardDir, $.verifiedPath, $.bedrockModelId))"
                        }
                      },
                      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 60, "MaxAttempts": 4, "BackoffRate": 2.0 }],
                      "Next": "MergeBedrockOCR"
                    },
                    "MergeBedrockOCR": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "LaunchType": "FARGATE",
                        "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                        "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                            "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [{
                            "Name": "validator",
                            "Command.$": "States.Array('python3', 'merge_shards.py', '--format', 'csv', '--shard-glob', States.Format('{}/shard_*_vision_title_check.csv', $.shardDir), '--expected-count', States.Format('{}', $.shardCount), '--out', $.visionPath)"
                          }]
                        }
                      },
                      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
                      "Next": "AfterBedrock"
                    },
                    "AfterBedrock": {
                      "Type": "Parallel",
                      "Comment": "05→06 and 09 both only need the merged vision_title_check.csv -- neither needs the other's output.",
                      "Branches": [
                        {
                          "StartAt": "ComprehendLanguageShards",
                          "States": {
                            "ComprehendLanguageShards": {
                              "Type": "Task",
                              "Resource": "arn:aws:states:::batch:submitJob.sync",
                              "Parameters": {
                                "jobName": "comprehend-language",
                                "jobQueue": "REPLACE_WITH_JOB_QUEUE_ARN",
                                "jobDefinition": "REPLACE_WITH_JOB_DEFINITION_ARN",
                                "arrayProperties": { "size.$": "$.shardCount" },
                                "containerOverrides": {
                                  "command.$": "States.Array('sh', '-c', States.Format('python3 scripts/05_comprehend_language.py --shard-index $AWS_BATCH_JOB_ARRAY_INDEX --shard-count {} --in {} --out {}/shard_${AWS_BATCH_JOB_ARRAY_INDEX}_language_detection.csv', $.shardCount, $.visionPath, $.shardDir))"
                                }
                              },
                              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
                              "Next": "MergeComprehendLanguage"
                            },
                            "MergeComprehendLanguage": {
                              "Type": "Task",
                              "Resource": "arn:aws:states:::ecs:runTask.sync",
                              "Parameters": {
                                "LaunchType": "FARGATE",
                                "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                                "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                                "NetworkConfiguration": {
                                  "AwsvpcConfiguration": {
                                    "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                                    "AssignPublicIp": "ENABLED"
                                  }
                                },
                                "Overrides": {
                                  "ContainerOverrides": [{
                                    "Name": "validator",
                                    "Command.$": "States.Array('python3', 'merge_shards.py', '--format', 'csv', '--shard-glob', States.Format('{}/shard_*_language_detection.csv', $.shardDir), '--expected-count', States.Format('{}', $.shardCount), '--out', $.languagePath)"
                                  }]
                                }
                              },
                              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
                              "Next": "TranslateTitlesShards"
                            },
                            "TranslateTitlesShards": {
                              "Type": "Task",
                              "Resource": "arn:aws:states:::batch:submitJob.sync",
                              "Parameters": {
                                "jobName": "translate-titles",
                                "jobQueue": "REPLACE_WITH_JOB_QUEUE_ARN",
                                "jobDefinition": "REPLACE_WITH_JOB_DEFINITION_ARN",
                                "arrayProperties": { "size.$": "$.shardCount" },
                                "containerOverrides": {
                                  "command.$": "States.Array('sh', '-c', States.Format('python3 scripts/06_translate_titles.py --shard-index $AWS_BATCH_JOB_ARRAY_INDEX --shard-count {} --in {} --titles {} --out {}/shard_${AWS_BATCH_JOB_ARRAY_INDEX}_translated_titles.csv', $.shardCount, $.languagePath, $.idsPath, $.shardDir))"
                                }
                              },
                              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
                              "Next": "MergeTranslateTitles"
                            },
                            "MergeTranslateTitles": {
                              "Type": "Task",
                              "Resource": "arn:aws:states:::ecs:runTask.sync",
                              "Parameters": {
                                "LaunchType": "FARGATE",
                                "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                                "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                                "NetworkConfiguration": {
                                  "AwsvpcConfiguration": {
                                    "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                                    "AssignPublicIp": "ENABLED"
                                  }
                                },
                                "Overrides": {
                                  "ContainerOverrides": [{
                                    "Name": "validator",
                                    "Command.$": "States.Array('python3', 'merge_shards.py', '--format', 'csv', '--shard-glob', States.Format('{}/shard_*_translated_titles.csv', $.shardDir), '--expected-count', States.Format('{}', $.shardCount), '--out', $.translatedPath)"
                                  }]
                                }
                              },
                              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
                              "End": true
                            }
                          }
                        },
                        {
                          "StartAt": "CollapseCompilations",
                          "States": {
                            "CollapseCompilations": {
                              "Type": "Task",
                              "Comment": "Not sharded, same reasoning as 07: only checks posters already found to be shared by 2+ ids -- a small set, not the full corpus.",
                              "Resource": "arn:aws:states:::ecs:runTask.sync",
                              "Parameters": {
                                "LaunchType": "FARGATE",
                                "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                                "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                                "NetworkConfiguration": {
                                  "AwsvpcConfiguration": {
                                    "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                                    "AssignPublicIp": "ENABLED"
                                  }
                                },
                                "Overrides": {
                                  "ContainerOverrides": [{
                                    "Name": "validator",
                                    "Command.$": "States.Array('python3', 'scripts/09_collapse_compilations.py', '--in', $.visionPath, '--out', $.compilationGroupsPath, '--cache', $.compilationCachePath)"
                                  }]
                                }
                              },
                              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
                              "End": true
                            }
                          }
                        }
                      ],
                      "End": true
                    }
                  }
                },
                {
                  "StartAt": "DedupePosterMD5",
                  "States": {
                    "DedupePosterMD5": {
                      "Type": "Task",
                      "Comment": "Not sharded -- 08's expensive part (downloading+hashing) already only runs on the ids in --in that have a poster_path, and its own --cache design defers the actual grouping to a cheap final pass, so it doesn't need Batch's array-job sharding on top of that.",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "LaunchType": "FARGATE",
                        "Cluster": "REPLACE_WITH_CLUSTER_ARN",
                        "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ["REPLACE_WITH_SUBNET_ID"],
                            "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [{
                            "Name": "validator",
                            "Command.$": "States.Array('python3', 'scripts/08_dedupe_poster_md5.py', '--in', $.idsPath, '--out', $.posterMd5DuplicatesPath, '--cache', $.posterMd5CachePath, '--verified', $.verifiedPath)"
                          }]
                        }
                      },
                      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
                      "End": true
                    }
                  }
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Next": "Assemble"
    },

    "Assemble": {
      "Type": "Task",
      "Comment": "Only reads the files every branch above already wrote -- 10_validate_corpus.py --assemble-only.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "REPLACE_WITH_CLUSTER_ARN",
        "TaskDefinition": "REPLACE_WITH_TASK_DEFINITION_ARN",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["REPLACE_WITH_SUBNET_ID"],
            "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [{
            "Name": "validator",
            "Command.$": "States.Array('python3', 'scripts/10_validate_corpus.py', '--assemble-only', '--genre', States.Format('{}', $.genre), '--ids-path', $.idsPath)"
          }]
        }
      },
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "End": true
    }
  }
}
