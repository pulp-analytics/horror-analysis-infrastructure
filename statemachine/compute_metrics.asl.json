                "containerOverrides": {
                  "command.$": "States.Array('sh', '-c', States.Format('python3 scripts/01_color_metrics.py --shard-index $AWS_BATCH_JOB_ARRAY_INDEX --shard-count {} --in {} --out {}/shard_${AWS_BATCH_JOB_ARRAY_INDEX}_color.csv', $.shardCount, $.metricsInputPath, $.shardDir))"
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3, "BackoffRate": 2.0 }],
              "Next": "MergeColorMetrics"
            },
