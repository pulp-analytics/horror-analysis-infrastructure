      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "REPLACE_WITH_CLUSTER_ARN",
        "TaskDefinition": "REPLACE_WITH_METRICS_TASK_DEFINITION_ARN",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["REPLACE_WITH_SUBNET_ID"],
            "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [{
            "Name": "metrics",
            "Command.$": "States.Array('python3', 'prepare_metrics_input.py', '--in', $.validatedCorpusPath, '--out', $.metricsInputPath)"
          }]
        }
      },
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Next": "ComputePerPosterMetrics"
    },

