                    "SecurityGroups": ["REPLACE_WITH_SECURITY_GROUP_ID"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [{
                    "Name": "metrics",
                    "Command.$": "States.Array('python3', 'merge_shards.py', '--format', 'csv', '--shard-glob', States.Format('{}/shard_*_color.csv', $.shardDir), '--expected-count', States.Format('{}', $.shardCount), '--out', $.colorPath)"
                  }]
                }
              },
              "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0 }],
              "End": true
            }
          }
        },
